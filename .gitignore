# Git metadata auxiliar local
.gitattributes.local
.gitconfig.local

# =========================
# Secretos y configuracion sensible
# =========================
.env
.env.*
!.env.example
!.env.*.example

# Claves, certificados y material criptografico
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa
id_ed25519

# Tokens, credenciales y baselines de seguridad
.secrets.baseline
*.secret
*.secrets
*.token
*.credentials

# Variables locales de herramienta
.python-version
.node-version
.tool-versions

# =========================
# Python
# =========================
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so
*.egg-info/
.eggs/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.nox/
.hypothesis/
.pyre/

# Cobertura, reportes y artefactos
.coverage
.coverage.*
coverage.xml
htmlcov/
bandit-report.*
pip-audit-report.*

# Entornos y builds
.venv/
venv/
env/
ENV/
build/
dist/

