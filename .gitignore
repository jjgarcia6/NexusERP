*.log
logs/
tmp/
temp/
.cache/
.tmp/
*.pid
*.seed

# =========================
# IDE / SO / historial local
# =========================
.vscode/
.idea/
.history/
.DS_Store
Thumbs.db
Desktop.ini
/documents/
